#include <stdio.h>

void insertMaxHeap(int heap[], int *n, int value)
{
    int i, parent, temp;

    heap[*n] = value;
    i = *n;
    (*n)++;

    while (i > 0)
    {
        parent = (i - 1) / 2;

        if (heap[parent] < heap[i])
        {
            temp = heap[parent];
            heap[parent] = heap[i];
            heap[i] = temp;

            i = parent;
        }
        else
        {
            break;
        }
    }
}

void display(int heap[], int n)
{
    int i;

    for (i = 0; i < n; i++)
        printf("%d ", heap[i]);

    printf("\n");
}

int main()
{
    int heap[20];
    int n = 0;
    int data[] = {45, 72, 30, 90, 65, 50, 85};
    int i;

    printf("Max Heap after each insertion:\n");

    for (i = 0; i < 7; i++)
    {
        insertMaxHeap(heap, &n, data[i]);
        printf("After inserting %d: ", data[i]);
        display(heap, n);
    }

    return 0;
}
